NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional server-only Admin API key for live organization spending on /spend in either MODE.
ANTHROPIC_ADMIN_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# fal was decommissioned on 2026-08-31; kie is the only vendor. FAL_KEY and
# FAL_ADMIN_KEY are gone, along with lib/fal-balance.ts and the balance check
# that used them — KIE_API_KEY below reads the kie balance instead, from the
# same key that renders (no admin/API scope split). Setting either does
# nothing; they are named here only so someone with an old .env.local knows
# why removing them changed nothing.
NEXT_PUBLIC_APP_URL=http://localhost:9000
NEXT_PUBLIC_THEME=studio-light
# Optional authenticated-app announcement. APP_BANNER_ID enables it and is
# also the dismissal version; change the ID when publishing a new campaign.
# Leave it empty to hide the banner.
APP_BANNER_ID=
APP_BANNER_TEXT=New models unlocked: Kling 3.0 + Gemini Omni Video
APP_BANNER_CTA=Create now
APP_BANNER_HREF=/projects
# MODE=development|production, defaulting to development (lib/mode.ts). One
# switch for the WHOLE process — no vendor call (Claude, fal, kie) is ever
# made in development, every one is real and billable in production.
#
# Replaced the old independent MOCK_CLAUDE/MOCK_FAL_IMAGE pair, which could
# each be set without the other (mock Claude but pay for real reference
# frames, or the reverse) — see lib/mode.ts's header for why that
# independence was given up. This ALSO used to be paired with worker/
# .env.example's own separate MOCK_FAL_VIDEO, whose independence from this
# value was exactly the incident lib/mode.ts's header describes: a render
# mocked here by a stale flag was claimed and billed by the deployed
# production worker anyway, because both poll the same scenes table and a
# flag set on one process has no say in which claims a row first. MODE
# fixes that on the write side (every enqueue writes scenes.dev = MODE ==
# 'development') — the worker's own MODE decides which dev value it claims.
MODE=development

# Milliseconds a MOCKED vendor call pretends to take (default 500, max 120000).
# Raise it to test what happens around a slow call rather than after one.
# Never affects a real call — it is read only from inside a mock branch.
# MOCK_DELAY_MS=30000
# The per-user daily threshold is no longer an env var. It is a setting an
# admin turns on from /users ("Enable daily cap"), stored in app_settings
# (0077_daily_cap_toggle.sql), with a per-account override on profiles.
# Weekly allowances and the optional global team cap are enforced regardless.
# Configure the global cap in Accounts Control; it defaults to enabled at $100/day.
DAILY_CAP_USD=100
# AUDIO_ENABLED=1 lets the cost estimate (and, once the worker also sees
# AUDIO_ENABLED=1, the actual render) route talking-head scenes to a
# lip-synced model. This said "the expensive lip-synced model" and shipped
# as 0 for that reason — no longer true, see worker/.env.example's own
# AUDIO_ENABLED block for the numbers: the audio model is now the cheaper
# one per second. Server-side only — deliberately NOT NEXT_PUBLIC_, since
# lib/models.ts's isAudioEnabled() is read from server components/actions
# and passed down as a prop, never inlined into the client bundle. MUST
# match worker/.env.example's AUDIO_ENABLED, or the "Ready to render"
# estimate quotes a price the worker won't actually charge.
AUDIO_ENABLED=1
# IMAGE_VENDOR (used to route reference-frame generation between fal and
# kie) is gone along with lib/image-vendor.ts and fal itself — lib/kie.ts's
# generateImage is the only image path left, unconditionally. No variable
# to set here any more.
# ASSEMBLE_ENABLED=1 tells the Deliver page (lib/models.ts's
# isAssembleEnabled) to show a quiet "assembling…" placeholder while it
# waits for the worker to produce a `final` asset. Default 0: matches
# worker/.env.example's ASSEMBLE_ENABLED default. Server-side only, same
# reasoning as AUDIO_ENABLED above. MUST match worker/.env.example's
# ASSEMBLE_ENABLED, or the placeholder either never shows while assembly is
# actually running, or sits waiting on a `final` asset the worker was never
# going to produce.
ASSEMBLE_ENABLED=0
# CAPTIONS_ENABLED=1 is worker/.env.example's CAPTIONS_ENABLED, declared
# here purely to keep both services' render.yaml blocks symmetric — unlike
# AUDIO_ENABLED/ASSEMBLE_ENABLED above, nothing in the web app currently
# reads this: captioning is a worker-side ffmpeg/libass burn-in step with no
# operator-facing cost estimate or Deliver-page affordance to keep in sync
# (yet). Default 0, matching worker/.env.example.
CAPTIONS_ENABLED=0
