# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Source media / research recordings ---
# Screen recordings may contain PII. Never commit.
*.mp4
*.mov
*.wav
*.srt
# Root-anchored on purpose. As a bare `frames/` this also matched
# web/app/(app)/projects/[id]/frames/, so the entire reference-frames page —
# gate 2 of the flow — was silently never committed and 404'd in production
# while working fine on every developer's machine.
/frames/
# Exception: a 22KB synthetic clip generated by ffmpeg, no camera involved and
# no PII possible. It is what MOCK_FAL serves so the mock pipeline can reach
# 'done' without the network — see worker/internal/http/mock.go. The rule above
# exists for the source recording; this file is not that.
!worker/internal/http/testdata/clip.mp4

# --- Generated video output ---
output/
renders/
tmp/

# --- Node ---
node_modules/
.next/
dist/
build/
*.tsbuildinfo
npm-debug.log*
bun-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude

# Generated by next.config (agentRules) — not source
web/AGENTS.md
web/CLAUDE.md

